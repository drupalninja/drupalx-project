# Optional overrides — the single-repo defaults work with no .env at all.
# The theme resolves to ../web/themes/custom/drupalx_theme and the recipe
# config dir to ../recipes/drupalx_canvas/config.

# DRUPALX_THEME_PATH=~/somewhere/else/web/themes/custom/drupalx_theme
# DRUPALX_RECIPE_CONFIG_PATH=~/somewhere/else/recipes/drupalx_canvas/config

# Canonical/OG/sitemap base for the static build (no trailing slash).
# BASE_URL=https://demo.example.com

# Dev server port (default 5050).
# PORT=5050
