{#
/**
 * Section: Hero — three styles from the bold-design playbook:
 *  glass — full-bleed photo, frosted GLASS PANEL carrying the copy (never a
 *          full-photo gradient scrim), Ken Burns drift on desktop.
 *  split — light editorial split: display type on white, photo as a rounded
 *          card with an accent offset frame + optional floating stat chip.
 *  dark  — solid brand-glow band, no photo required.
 *  fullbleed — huge type DIRECTLY on a scrimmed photo; type IS the graphic.
 *          The destination-bold option and the only one with real contrast
 *          risk, since nothing sits between the type and the picture. Hence a
 *          two-part scrim (bottom-weighted gradient where the text sits, plus
 *          a light overall tint) rather than one flat wash. Needs a genuinely
 *          good, mostly dark or evenly lit photograph — when the photo is not
 *          that, `glass` gives the type its own panel and `dark` drops the
 *          photo, and both beat a heavier scrim.
 *  feature — photo held in a rounded card inside a TINTED BAND, type beside
 *          it, optional stat chip. Softer and more forgiving of an imperfect
 *          photo than a bled crop; the mission-warm pick. (`split` is the same
 *          idea on WHITE with an accent offset frame — feature reads warmer.)
 * Heights are CAPPED (hero-h-*) — raw vh blows up the Canvas editor iframe.
 *
 * `section-hero__img` on every hero <img> is LOAD-BEARING, not styling.
 * site/optimize-images.cjs finds the LCP image by that class alone and gives
 * it fetchpriority=high, a sizes="100vw" hint and an LQIP background; every
 * other image gets loading=lazy and a 50vw hint. NO hero img carried the
 * class, so the match never fired: heroes shipped lazy-loaded and the browser
 * picked a 768px variant for a full-bleed 1440px band off the 50vw hint —
 * a visibly soft hero and a wrecked LCP on every page of every pilot.
 * Found on the ssseva build, 2026-08-09.
 */
#}
{% set style = style|default('split') %}
{% set height = height|default('full') %}
{% set has_image = image.src|default('') is not empty %}
{% set image_position = image_position|default('right') %}
{% set align = align|default('center') %}
{% set panel_width = panel_width|default('lg') %}
{% set eyebrow_icon = eyebrow_icon|default('none') %}
{# .hero--text switches to the shorter text-only height scale (global.css).
   A hero with no photo has nothing to fill an image-sized band with. #}
{% set height_class = 'hero-h-' ~ height ~ (has_image ? '' : ' hero--text') %}
{# Capture the slot ONCE (block names must be unique per template), print the
   captured HTML in whichever style branch renders. #}
{% set hero_buttons_html %}{% block hero_buttons %}{% endblock %}{% endset %}

{# AI concierge ask-bar — the concierge's ONLY entry point (there is no floating
   launcher; see _concierge.html.twig). Opt in per page with concierge: true and
   pass the persona as concierge_assistant; the overlay itself is included from
   the layout on the front page. Captured once like hero_buttons_html and
   printed in whichever branch renders, so all five hero styles carry it.
   glass / dark / fullbleed put type on a dark surface, so the bar takes its
   translucent-on-dark treatment; feature and split are light. #}
{% set hero_is_light = style not in ['glass', 'dark', 'fullbleed'] %}
{% set hero_ask_html %}
  {% if concierge|default(false) %}
    {% include '@drupalx_theme/templates/partials/_concierge-ask.html.twig' with {
      assistant: concierge_assistant|default(null),
      light: hero_is_light,
    } only %}
  {% endif %}
{% endset %}

{% set io = has_image ? dx_image(image, '100vw') : { srcset: null, sizes: null, width: null, height: null } %}

{% if style == 'glass' and has_image %}
  {# Glass panel geometry — align and panel_width are the two knobs Astro
     pilots forked HeroGlass for (4 of 13). Static class maps per the
     Tailwind-v4 literal-class rule. #}
  {% set panel_max = { 'md': 'max-w-xl', 'lg': 'max-w-3xl' }[panel_width]|default('max-w-3xl') %}
  {% set panel_justify = { 'center': 'justify-center', 'left': 'justify-start' }[align]|default('justify-center') %}
  {% set panel_align = { 'center': 'text-center', 'left': 'text-left' }[align]|default('text-center') %}
  {% set cta_justify = { 'center': 'justify-center', 'left': 'justify-start' }[align]|default('justify-center') %}
  <section data-surface="dark" class="section-hero full-bleed relative overflow-hidden {{ height_class }} flex items-center">
    <img
      src="{{ image.src }}" alt="{{ image.alt|default('') }}"
      class="section-hero__img ken-burns absolute inset-0 h-full w-full object-cover"
      fetchpriority="high" decoding="async"
      {% if io.srcset %}srcset="{{ io.srcset }}" sizes="100vw"{% endif %}
    >
    {# Asymmetric padding: the panel rides HIGH on the photo with a generous
       bottom well so a following section_directory (-mt-24/28/36) lands in
       photo space below the panel, never on the ask-bar. Symmetric py-16
       put the tiles straight across the panel's bottom edge (sbcog, 2026-08-21).
       Tint 0.80 is MEASURED for white body AA over bright sky bands. #}
    <div class="relative max-w-site mx-auto w-full px-4 pt-14 pb-36 sm:px-6 sm:pb-40 lg:px-8 lg:pb-48 flex {{ panel_justify }}">
      {# p-6 on a phone, not p-8: the panel IS the whole viewport there, and every
         8px of padding is 8px less photograph (2026-08-26). #}
      <div class="{{ panel_max }} w-full rounded-2xl bg-primary-900/80 backdrop-blur-md border border-white/15 p-6 {{ panel_align }} sm:p-10 shadow-2xl">
        {% if eyebrow|default('') %}
          <p class="eyebrow mb-3 text-white">
            {% if eyebrow_icon != 'none' %}
              <span class="dx-icon dx-icon--sm text-white" aria-hidden="true">{{- source('@drupalx_theme/dist/icons/' ~ eyebrow_icon ~ '.svg') -}}</span>
            {% endif %}
            {{ eyebrow }}
          </p>
        {% endif %}
        <h1 class="hero-display text-white">{{ title }}</h1>
        {% if body|default('') %}
          <div class="mt-4 text-lg leading-relaxed text-primary-100">{{ body|raw }}</div>
        {% endif %}
        <div class="mt-6 flex flex-wrap {{ cta_justify }} gap-3">
          {{ hero_buttons_html }}
        </div>
        {{ hero_ask_html }}
      </div>
    </div>
  </section>

{% elseif style == 'dark' or (style == 'glass' and not has_image) %}
  <section data-surface="dark" class="section-hero full-bleed brand-glow relative overflow-hidden {{ height_class }} flex items-center">
    <div class="section-hero__inner relative max-w-site mx-auto w-full px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-3xl">
        {% if eyebrow|default('') %}
          <p class="eyebrow mb-3">{{ eyebrow }}</p>
        {% endif %}
        <h1 class="hero-display text-white">{{ title }}</h1>
        {% if body|default('') %}
          <div class="mt-4 text-lg leading-relaxed text-primary-100">{{ body|raw }}</div>
        {% endif %}
        <div class="mt-6 flex flex-wrap gap-3">
          {{ hero_buttons_html }}
        </div>
        {{ hero_ask_html }}
      </div>
    </div>
  </section>

{% elseif style == 'fullbleed' and has_image %}
  <section data-surface="dark" class="section-hero full-bleed relative isolate flex items-end overflow-hidden {{ height_class }}">
    <img
      src="{{ image.src }}" alt="{{ image.alt|default('') }}"
      class="section-hero__img absolute inset-0 -z-10 h-full w-full object-cover object-[center_35%]"
      fetchpriority="high" decoding="async"
      {% if io.srcset %}srcset="{{ io.srcset }}" sizes="100vw"{% endif %}
    >
    {# Two-part scrim, not one plate: a single to-transparent wash over the
       whole image is the thing the design system calls flat and muddy. #}
    <div class="absolute inset-0 -z-10 bg-black/25" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-t from-black/80 via-black/45 to-transparent" aria-hidden="true"></div>

    <div class="section-hero__inner relative max-w-site mx-auto w-full px-4 pb-16 pt-28 sm:px-6 lg:px-8 lg:pb-20">
      <div class="max-w-4xl">
        {% if eyebrow|default('') %}
          <p class="eyebrow text-white/85">{{ eyebrow }}</p>
        {% endif %}
        <h1 class="hero-display mt-4 text-white drop-shadow-sm">{{ title }}</h1>
        {% if body|default('') %}
          <div class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90">{{ body|raw }}</div>
        {% endif %}
        <div class="mt-8 flex flex-wrap gap-3">
          {{ hero_buttons_html }}
        </div>
        {{ hero_ask_html }}
      </div>
    </div>
  </section>

{% elseif style == 'feature' %}
  <section class="full-bleed bg-primary-50/60 py-14 lg:py-20">
    <div class="max-w-site mx-auto w-full px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
        <div>
          {% if eyebrow|default('') %}
            {# No text-accent-600 here: .eyebrow is in @layer components precisely so a
             utility WINS, and this palette's accent-600 is a gold at 3.33:1 on white —
             it fails AA as text by a wide margin. The .eyebrow default is
             primary-600 (6.83:1). #}
          <p class="eyebrow">{{ eyebrow }}</p>
          {% endif %}
          <h1 class="hero-display mt-4 text-primary-900">{{ title }}</h1>
          {% if body|default('') %}
            <div class="mt-5 max-w-xl text-lg leading-relaxed text-ink-700">{{ body|raw }}</div>
          {% endif %}
          <div class="mt-8 flex flex-wrap gap-3">
            {{ hero_buttons_html }}
          </div>
          {{ hero_ask_html }}
        </div>
        {% if has_image %}
          <div class="relative">
            <img
              src="{{ image.src }}" alt="{{ image.alt|default('') }}"
              class="section-hero__img aspect-4/3 w-full rounded-2xl object-cover shadow-lg"
              fetchpriority="high" decoding="async"
              {% if io.srcset %}srcset="{{ io.srcset }}" sizes="(min-width: 1024px) 50vw, 100vw"{% endif %}
            >
            {% if stat_chip_number|default('') %}
              <div class="absolute -bottom-6 left-6 rounded-2xl bg-primary-900 px-6 py-4 shadow-xl">
                <p class="text-3xl font-extrabold leading-none text-white">{{ stat_chip_number }}</p>
                {% if stat_chip_label|default('') %}
                  <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-primary-200">{{ stat_chip_label }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>

{% else %}
  {# split — light editorial. image_position flips the photo to the left
     on lg (the text column gets order-2). On mobile the photo stacks below
     the text regardless, which is the right default for a tall text block. #}
  {% set split_flip = image_position == 'left' ? 'lg:[&>*:first-child]:order-2' : '' %}
  <section class="full-bleed relative overflow-hidden bg-white">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(55% 65% at 85% 12%, color-mix(in srgb, var(--color-accent-500) 9%, transparent), transparent 70%);"></div>
    <div class="relative max-w-site mx-auto w-full px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-10 py-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16 {{ height_class }} {{ split_flip }}">
        <div>
          <span class="mb-4 block h-1 w-12 rounded-full bg-accent-500" aria-hidden="true"></span>
          {% if eyebrow|default('') %}
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary-600 sm:text-sm">{{ eyebrow }}</p>
          {% endif %}
          <h1 class="hero-display mt-4 text-primary-800">{{ title }}</h1>
          {% if body|default('') %}
            <div class="mt-4 max-w-lg text-base leading-relaxed text-ink-500 sm:text-lg">{{ body|raw }}</div>
          {% endif %}
          <div class="mt-6 flex flex-wrap gap-3">
            {{ hero_buttons_html }}
          </div>
          {{ hero_ask_html }}
        </div>
        {% if has_image %}
          {# Padding + offset match section_split's image treatment. The hero
             used a larger pb-8/lg:pb-10 well and a bigger lg:translate-6
             offset, which made the same 4:3 image occupy noticeably more
             vertical space than the identical treatment one section below —
             the split hero read as "too tall" against its own text column. #}
          <div class="relative self-center pb-6 pr-4 lg:pb-8 lg:pr-6">
            <div class="absolute top-0 left-0 right-4 bottom-6 translate-x-4 translate-y-4 rounded-2xl bg-accent-500/25 lg:right-6 lg:bottom-8 lg:translate-x-6 lg:translate-y-6" aria-hidden="true"></div>
            <div class="relative aspect-4/3 overflow-hidden rounded-2xl shadow-xl">
              <img
                src="{{ image.src }}" alt="{{ image.alt|default('') }}"
                class="section-hero__img ken-burns absolute inset-0 h-full w-full object-cover"
                fetchpriority="high" decoding="async"
                {% if io.srcset %}srcset="{{ io.srcset }}" sizes="(min-width: 1024px) 50vw, 100vw"{% endif %}
              >
            </div>
            {% if stat_chip_number|default('') %}
              <div class="absolute -bottom-1 left-4 rounded-xl bg-primary-800 px-5 py-3.5 text-white shadow-xl lg:left-8">
                <p class="text-2xl font-black leading-none">{{ stat_chip_number }}</p>
                {% if stat_chip_label|default('') %}
                  <p class="mt-1 text-xs font-medium text-primary-100">{{ stat_chip_label }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}
