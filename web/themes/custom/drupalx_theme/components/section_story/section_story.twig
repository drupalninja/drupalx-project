{#
/**
 * Section: Story — editorial testimonial band on a dark brand surface. A
 * portrait photo (4:5) beside an eyebrow, heading, blockquote with an accent
 * left-border, attribution, and an optional CTA. The "faces of" pattern built
 * in 3+ nonprofit engagements (sepsis SurvivorStory, cbtrust impact pages,
 * nmvoices resident stories).
 *
 * Ported from the sepsis-2026 SurvivorStory.astro (2026-08-12). Distinct from
 * section_quote: that is a centered text-only pull-quote with a small round
 * avatar; this is a full editorial split with a large portrait, heading, and
 * CTA — a story, not a one-liner.
 *
 * Canonical vocabulary: `story`. Astro twin: SurvivorStory.astro.
 */
#}
{% set has_image = image.src|default('') is not empty %}
{% set io = has_image ? dx_image(image, '(min-width: 1024px) 45vw, 100vw') : { srcset: null } %}
{% set story_buttons_html %}{% block story_buttons %}{% endblock %}{% endset %}

<section data-surface="dark" class="full-bleed brand-glow py-20 text-white">
  <div class="mx-auto grid max-w-content gap-10 px-4 sm:px-6 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:px-8">
    {% if has_image %}
      <img
        src="{{ image.src }}" alt="{{ image.alt|default(person|default('')) }}"
        class="aspect-[4/5] w-full rounded-3xl object-cover shadow-2xl"
        loading="eager" decoding="async"
        {% if io.srcset %}srcset="{{ io.srcset }}" sizes="{{ io.sizes }}"{% endif %}
      >
    {% endif %}
    <div class="max-w-2xl">
      {% if eyebrow|default('') %}
        <p class="text-sm font-bold uppercase tracking-[.2em] text-accent-200">{{ eyebrow }}</p>
      {% endif %}
      {% if title|default('') %}
        <h2 class="mt-3 text-3xl font-extrabold !text-white sm:text-4xl">{{ title }}</h2>
      {% endif %}
      <blockquote class="mt-7 border-l-4 border-accent-300 pl-6 text-xl leading-relaxed text-white/95 sm:text-2xl">
        {{ quote|raw }}
      </blockquote>
      {% if person|default('') %}
        <p class="mt-5 font-bold text-accent-100">&mdash; {{ person }}</p>
      {% endif %}
      {% if story_buttons_html|trim %}
        <div class="mt-7 flex flex-wrap gap-3">
          {{ story_buttons_html }}
        </div>
      {% elseif cta_url|default('') and cta_label|default('') %}
        <a href="{{ cta_url }}" class="mt-7 inline-flex rounded-full bg-white px-6 py-3 text-sm font-bold text-primary-900 transition-colors hover:bg-primary-50">
          {{ cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>
