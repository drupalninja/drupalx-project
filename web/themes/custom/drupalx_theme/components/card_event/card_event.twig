{#
/**
 * Event card — date-block teaser (spark-card). Child of the Card grid.
 */
#}
{% set c = c|default('none') %}
{% set c_map = {
  'none': 'bg-primary-700',
  'sky': 'bg-sky-600',
  'clay': 'bg-clay-600',
  'accent': 'bg-accent-600',
} %}
{# An event card sat beside an image-led news card renders as a small date
   chip in a tall empty box — the grid row stretches both to the same height
   and only one has anything to fill it. Optional image, same 16/10 crop and
   object-cover as card_news so a news/events pair reads as one row. #}
{% set has_image = image.src|default('') is not empty %}
{% set io = has_image ? dx_image(image, '(min-width: 1024px) 33vw, 100vw') : { srcset: null } %}
<article class="spark-card relative flex h-full flex-col overflow-hidden rounded-2xl border border-primary-100 bg-white shadow-sm">
  {% if has_image %}
    <div class="overflow-hidden">
      <img src="{{ image.src }}" alt="{{ image.alt|default('') }}"
           class="spark-card__img aspect-[16/10] w-full object-cover" loading="lazy" decoding="async"
           {% if io.srcset %}srcset="{{ io.srcset }}" sizes="{{ io.sizes }}"{% endif %}>
    </div>
  {% endif %}
  <div class="flex flex-1 gap-4 p-5">
  {% if month|default('') or day|default('') %}
    <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-xl {{ c_map[c]|default(c_map['none']) }} text-white">
      <span class="text-[0.75rem] font-bold uppercase tracking-[0.14em]">{{ month }}</span>
      <span class="text-2xl font-black leading-none">{{ day }}</span>
    </div>
  {% endif %}
  <div class="flex min-w-0 flex-1 flex-col">
    <h3 class="font-bold leading-snug text-primary-800">
      {% if url|default('') %}
        <a href="{{ url }}" class="after:absolute after:inset-0 focus:outline-none">{{ title }}</a>
      {% else %}{{ title }}{% endif %}
    </h3>
    <ul class="mt-2 grid gap-1 text-sm text-ink-500">
      {% if time|default('') %}
        <li class="flex items-center gap-1.5">
          {% include 'drupalx_theme:icon' with { name: 'clock', size: 'sm' } only %}
          {{ time }}
        </li>
      {% endif %}
      {% if location|default('') %}
        <li class="flex items-center gap-1.5">
          {% include 'drupalx_theme:icon' with { name: 'map-pin', size: 'sm' } only %}
          {{ location }}
        </li>
      {% endif %}
    </ul>
  </div>
</div>
</article>
