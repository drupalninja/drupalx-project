{#
/**
 * Section: Card grid — spark-card children in a responsive grid. With
 * featured_first, the first card spans two columns (bento). Card children
 * stretch to equal height (grid + h-full on the card).
 */
#}
{% import '@drupalx_theme/components/_section/_section.twig' as sx %}
{% set columns = columns|default('3') %}
{% set tone = tone|default('white') %}
{% set featured = featured_first|default(false) %}
{% set col_map = {
  '2': 'sm:grid-cols-2',
  '3': 'sm:grid-cols-2 lg:grid-cols-3',
  '4': 'sm:grid-cols-2 lg:grid-cols-4',
} %}
<section class="full-bleed {{ tone == 'tint' ? 'bg-primary-50' : 'bg-white' }} py-16 md:py-24" data-reveal>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    {{ sx.header(eyebrow|default(''), title|default(''), lede|default(''), 'left', false) }}
    <div class="grid gap-6 {{ col_map[columns]|default(col_map['3']) }} {{ featured ? 'sm:[&>*:first-child]:col-span-2' : '' }}">
      {% block cards %}{% endblock %}
    </div>
  </div>
</section>
